{
  "name": "form-rescue",
  "version": "0.1.0",
  "private": true,
  "description": "Never lose a long web form again. Local-only autosave and restore for long web forms.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && node scripts/build.mjs",
    "verify:extension": "node scripts/verify-extension.mjs",
    "capture:docs": "node scripts/capture-docs.mjs",
    "demo": "node scripts/serve-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/chrome": "^0.0.328",
    "@types/node": "^26.6.1",
    "eslint": "^9.36.0",
    "globals": "^15.15.0",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
